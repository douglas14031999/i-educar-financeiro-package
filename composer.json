{
    "name": "douglas14031999/i-educar-financeiro-package",
    "description": "Módulo Financeiro Oficial para o i-Educar (Escolas Privadas e Comunitárias)",
    "type": "library",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Douglas",
            "homepage": "https://github.com/douglas14031999"
        }
    ],
    "require": {
        "php": ">=8.3",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/view": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^10.12"
    },
    "autoload": {
        "psr-4": {
            "iEducar\\Financeiro\\": "src/",
            "iEducar\\Financeiro\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "iEducar\\Financeiro\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "iEducar\\Financeiro\\FinanceiroServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
